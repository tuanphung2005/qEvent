# Copy to `.env` (`cp .env.example .env`) before `docker compose up`.
# `.env` is gitignored; never commit real secrets.

# Signs every JWT. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_openssl_rand_hex_32

# Shared token for service-to-service calls (event/admission/engagement).
INTERNAL_SERVICE_TOKEN=change_me_internal_service_token

# Postgres password for the three local databases (bound to 127.0.0.1 only).
POSTGRES_PASSWORD=password123
