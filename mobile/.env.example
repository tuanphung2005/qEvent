# Copy to .env.local. Never put secrets here: EXPO_PUBLIC_* is bundled into the app.
# iOS simulator: http://localhost:8000
# Android emulator: http://10.0.2.2:8000
# Real device: http://<LAN-IP>:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Maestro only. Set to 1 to inject a fixture session instead of driving login.
# EXPO_PUBLIC_E2E=1
# EXPO_PUBLIC_E2E_TOKEN=
