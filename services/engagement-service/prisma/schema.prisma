datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model QAQuestion {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  content   String
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())
  votes     QAVote[]
}

model QAVote {
  id         String     @id @default(uuid())
  questionId String
  userId     String
  question   QAQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
}

model Poll {
  id        String       @id @default(uuid())
  sessionId String
  title     String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  options   PollOption[]
}

model PollOption {
  id        String     @id @default(uuid())
  pollId    String
  content   String
  voteCount Int        @default(0)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]
}

model PollVote {
  id       String     @id @default(uuid())
  optionId String
  userId   String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
}

model QuizGame {
  id                   String         @id @default(uuid())
  sessionId            String         @unique
  status               String         @default("WAITING")
  currentQuestionIndex Int            @default(0)
  questions            QuizQuestion[]
}

model QuizQuestion {
  id                String       @id @default(uuid())
  gameId            String
  orderNum          Int
  content           String
  options           String[]
  correctOption     Int
  timeLimitSec      Int          @default(30)
  questionStartedAt DateTime?
  game              QuizGame     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers           QuizAnswer[]

  @@unique([gameId, orderNum])
}

model QuizAnswer {
  id             String       @id @default(uuid())
  questionId     String
  userId         String
  selectedOption Int
  responseTimeMs Int
  score          Int          @default(0)
  answeredAt     DateTime     @default(now())
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
}
