{
  "info": {
    "name": "qEvent Microservices (Gateway)",
    "description": "End-to-end requests for the three services through the API Gateway (http://localhost:8000). Import qEvent_Local.postman_environment.json, run the Auth folder first (tokens and ids are captured automatically), then run the remaining folders. Demo accounts come from the service seeds; run `docker compose up -d` first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Organizer login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('organizerToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{organizerEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Staff login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('staffToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Attendee login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('attendeeToken', body.token);",
                  "pm.collectionVariables.set('attendeeId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{attendeeEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Register a new attendee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('attendeeToken', body.token);",
                  "pm.collectionVariables.set('attendeeId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"attendee-{{$timestamp}}@qevent.test\",\n  \"password\": \"password123\",\n  \"fullName\": \"Postman Attendee\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Health",
      "item": [
        {
          "name": "Gateway and downstream health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('all downstreams ok', () => {",
                  "  const body = pm.response.json();",
                  "  Object.values(body.downstream).forEach((v) => pm.expect(v).to.eql('ok'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Events (Event Service)",
      "item": [
        {
          "name": "List events (captures ids)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.events.length > 0) {",
                  "  const event = body.events[0];",
                  "  pm.collectionVariables.set('eventId', event.id);",
                  "  if (event.sessions.length > 0) pm.collectionVariables.set('sessionId', event.sessions[0].id);",
                  "  if (event.ticketTypes.length > 0) pm.collectionVariables.set('ticketTypeId', event.ticketTypes[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            }
          }
        },
        {
          "name": "Get event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Create event (organizer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('eventId', body.event.id);",
                  "if (body.event.sessions.length > 0) pm.collectionVariables.set('sessionId', body.event.sessions[0].id);",
                  "if (body.event.ticketTypes.length > 0) pm.collectionVariables.set('ticketTypeId', body.event.ticketTypes[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Summit {{$timestamp}}\",\n  \"venue\": \"Saigon Exhibition Center\",\n  \"startTime\": \"2030-01-01T09:00:00.000Z\",\n  \"endTime\": \"2030-01-01T17:00:00.000Z\",\n  \"maxCapacity\": 100,\n  \"sessions\": [\n    { \"title\": \"Opening Keynote\", \"speaker\": \"Alex Nguyen\", \"startTime\": \"2030-01-01T09:00:00.000Z\", \"endTime\": \"2030-01-01T10:00:00.000Z\", \"isLive\": true }\n  ],\n  \"ticketTypes\": [\n    { \"name\": \"Standard\", \"price\": 25, \"quota\": 100 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            }
          }
        },
        {
          "name": "Update event capacity (organizer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 409 CAPACITY_BELOW_RESERVED', () => {",
                  "  pm.expect([200, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maxCapacity\": 120\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "{{eventId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Orders, tickets and check-in (Admission Service)",
      "item": [
        {
          "name": "Create order (attendee, idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('orderId', body.order.id);",
                  "pm.collectionVariables.set('ticketId', body.order.tickets[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"ticketTypeId\": \"{{ticketTypeId}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendeeToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "List my tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('no qrSecret leaked', () => {",
                  "  const body = pm.response.json();",
                  "  body.tickets.forEach((t) => pm.expect(t.qrSecret).to.be.undefined);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendeeToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "my"]
            }
          }
        },
        {
          "name": "Get dynamic QR token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('qrToken', pm.response.json().qrToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendeeToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/qr-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}", "qr-token"]
            }
          }
        },
        {
          "name": "Check in (staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 CHECKIN_SUCCESS', () => {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "  pm.expect(pm.response.json().code).to.eql('CHECKIN_SUCCESS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrToken\": \"{{qrToken}}\",\n  \"deviceId\": \"gate:postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkins",
              "host": ["{{baseUrl}}"],
              "path": ["api", "checkins"]
            }
          }
        },
        {
          "name": "Sync an offline scan (staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK with a per-scan result', () => {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "  pm.expect(pm.response.json().results[0].status).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"logs\": [\n    { \"ticketId\": \"{{ticketId}}\", \"scannedAt\": \"{{$isoTimestamp}}\", \"deviceId\": \"gate:offline\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkins/sync-offline",
              "host": ["{{baseUrl}}"],
              "path": ["api", "checkins", "sync-offline"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Live Q&A (Engagement Service)",
      "item": [
        {
          "name": "List questions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "questions"]
            }
          }
        },
        {
          "name": "Ask a question (checked-in attendee)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created (BR-6 passed)', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('questionId', pm.response.json().question.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"How does the circuit breaker recover?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "questions"]
            }
          }
        },
        {
          "name": "Toggle upvote (attendee)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendeeToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}/votes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "questions", "{{questionId}}", "votes"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Polls (Engagement Service)",
      "item": [
        {
          "name": "List polls (captures ids)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.polls.length > 0) {",
                  "  pm.collectionVariables.set('pollId', body.polls[0].id);",
                  "  pm.collectionVariables.set('pollOptionId', body.polls[0].options[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/polls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "polls"]
            }
          }
        },
        {
          "name": "Create poll (organizer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const poll = pm.response.json().poll;",
                  "pm.collectionVariables.set('pollId', poll.id);",
                  "pm.collectionVariables.set('pollOptionId', poll.options[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"How was the keynote?\",\n  \"options\": [\"Very good\", \"Okay\", \"Needs work\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/polls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "polls"]
            }
          }
        },
        {
          "name": "Vote in poll (attendee)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionId\": \"{{pollOptionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/polls/{{pollId}}/vote",
              "host": ["{{baseUrl}}"],
              "path": ["api", "polls", "{{pollId}}", "vote"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Quiz game (Engagement Service)",
      "item": [
        {
          "name": "Create or get session game (organizer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 201', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "pm.collectionVariables.set('gameId', pm.response.json().game.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/game",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "game"]
            }
          }
        },
        {
          "name": "Add quiz question (organizer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created (or 409 if already started)', () => {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) pm.collectionVariables.set('quizQuestionId', pm.response.json().question.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Which algorithm prevents double check-in?\",\n  \"options\": [\"2PL\", \"CAS\", \"DNS round robin\"],\n  \"correctOption\": 1,\n  \"timeLimitSec\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/game/{{gameId}}/question",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "{{gameId}}", "question"]
            }
          }
        },
        {
          "name": "Start game (organizer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK (or 409 if already started)', () => pm.expect([200, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/game/{{gameId}}/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "{{gameId}}", "start"]
            }
          }
        },
        {
          "name": "Read game (host view)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const game = pm.response.json().game;",
                  "const q = game.questions[game.currentQuestionIndex];",
                  "if (q) pm.collectionVariables.set('quizQuestionId', q.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/game/{{gameId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "game", "{{gameId}}"]
            }
          }
        },
        {
          "name": "Submit answer (attendee)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK (or 409 already answered)', () => pm.expect([200, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "body": {
              "mode": "raw",
