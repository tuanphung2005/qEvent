# Dev: leave empty so Vite proxies /api and /ws to http://localhost:8000.
# Production: leave empty so Nginx proxies on the same origin.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_APP_ENV=development

# Playwright only: where the gateway and the dev server live.
E2E_API_BASE=http://localhost:8000
E2E_WEB_BASE=http://localhost:5173
