# Both default to empty: the SPA calls /api and /ws on its own origin, which
# `bun run dev` (Vite proxy) and the compose `web` container (Nginx proxy) forward
# to the real gateway at http://api-gateway:8000 / http://localhost:8000.
# Set them only when the SPA is served from a different origin than the gateway.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Playwright only: where the gateway and the dev server live.
E2E_API_BASE=http://localhost:8000
E2E_WEB_BASE=http://localhost:5173
