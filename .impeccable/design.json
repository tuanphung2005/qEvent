  \"components\": [
    {\n      \"name\": \"Primary Button\",\n      \"kind\": \"button\",\n      \"refersTo\": \"button-primary\",\n      \"description\": \"Primary high-priority action button for login, ticket purchase, and check-in confirmation.\",\n      \"html\": \"<button class=\\\"ds-btn-primary\\\">Điểm danh vé</button>\",\n      \"css\": \".ds-btn-primary { background: #2563EB; color: #FFFFFF; font-family: sans-serif; font-size: 14px; font-weight: 600; padding: 12px 24px; border: none; border-radius: 12px; cursor: pointer; transition: background 0.2s, opacity 0.2s; min-height: 48px; display: inline-flex; align-items: center; justify-content: center; } .ds-btn-primary:hover { background: #1D4ED8; } .ds-btn-primary:active { opacity: 0.85; }\"\n    },\n    {\n      \"name\": \"Secondary Button\",\n      \"kind\": \"button\",\n      \"refersTo\": \"button-secondary\",\n      \"description\": \"Secondary neutral button for filters, downloads, or alternative options.\",\n      \"html\": \"<button class=\\\"ds-btn-secondary\\\">Tải lại Cache</button>\",\n      \"css\": \".ds-btn-secondary { background: #F1F5F9; color: #0F172A; font-family: sans-serif; font-size: 14px; font-weight: 600; padding: 12px 24px; border: none; border-radius: 12px; cursor: pointer; transition: background 0.2s; min-height: 48px; display: inline-flex; align-items: center; justify-content: center; } .ds-btn-secondary:hover { background: #E2E8F0; }\"\n    },\n    {\n      \"name\": \"Content Card\",\n      \"kind\": \"card\",\n      \"refersTo\": \"card\",\n      \"description\": \"Standard borderless content card elevated by bottom drop shadow.\",\n      \"html\": \"<div class=\\\"ds-card\\\"><div class=\\\"ds-card-title\\\">Tech Expo 2026</div><div class=\\\"ds-card-body\\\">Vé VIP • Cổng A • Ghế 12A</div></div>\",\n      \"css\": \".ds-card { background: #FFFFFF; border-radius: 16px; padding: 16px; border: none; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.07); font-family: sans-serif; } .ds-card-title { font-size: 16px; font-weight: 600; color: #0F172A; margin-bottom: 4px; } .ds-card-body { font-size: 14px; color: #334155; }\"\n    },\n    {\n      \"name\": \"Pill Badge (Success)\",\n      \"kind\": \"chip\",\n      \"refersTo\": \"badge\",\n      \"description\": \"High-contrast status pill indicating confirmed check-in or valid state.\",\n      \"html\": \"<span class=\\\"ds-badge-success\\\">ĐÃ ĐIỂM DANH</span>\",\n      \"css\": \".ds-badge-success { background: #ECFDF5; color: #10B981; font-family: sans-serif; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 9999px; border: none; display: inline-flex; align-items: center; letter-spacing: 0.5px; }\"\n    },\n    {\n      \"name\": \"Text Input\",\n      \"kind\": \"input\",\n      \"refersTo\": \"input\",\n      \"description\": \"Borderless, high-contrast text input field with readable placeholder.\",\n      \"html\": \"<input class=\\\"ds-input\\\" type=\\\"text\\\" placeholder=\\\"nhap.email@example.com\\\" />\",\n      \"css\": \".ds-input { background: #F1F5F9; color: #0F172A; font-family: sans-serif; font-size: 14px; padding: 12px 16px; border-radius: 12px; border: none; outline: none; width: 100%; box-sizing: border-box; transition: background 0.2s; } .ds-input::placeholder { color: #475569; opacity: 1; } .ds-input:focus { background: #E2E8F0; }\"\n    }\n  ],\n  \"narrative\": {\n    \"northStar\": \"The High-Throughput Beacon\",\n    \"overview\": \"qCheck is an operational mobile tool built for intense, high-stakes physical environments: noisy venue entrance gates, dim auditoriums, and crowded queue lines under bright outdoor glare. The visual architecture rejects decorative fluff, blurred materials, and multi-layered visual noise in favor of immediate, unambiguous clarity.\",\n    \"keyCharacteristics\": [\n      \"Zero-Border Discipline: Total elimination of outline borders, hairlines, and card strokes.\",\n      \"High-Visibility Status Hierarchy: Immediate color-coded states paired with multi-sensory feedback.\",\n      \"Glare-Resistant Light Theme: High-contrast dark Slate typography over white and slate foundations.\",\n      \"No Light Grey Text: Absolute elimination of low-contrast light grey text across all screens.\",\n      \"Gluestack + Native Ergonomics: Large touch targets, predictable bottom bar layouts, and touchable card containers.\"\n    ],\n    \"rules\": [\n      {\n        \"name\": \"The Borderless Boundary Rule\",\n        \"body\": \"Never use borderWidth: 1 or hairline divider lines to separate components or card sections.\",\n        \"section\": \"colors\"\n      },\n      {\n        \"name\": \"The High-Contrast Legibility Rule\",\n        \"body\": \"Never use light grey text colors (#94A3B8, #CBD5E1, #9CA3AF) for any label, placeholder, or indicator. All typography must maintain sharp contrast >= 4.5:1 against its background.\",\n        \"section\": \"colors\"\n      },\n      {\n        \"name\": \"The Semantic Monosemy Rule\",\n        \"body\": \"Emerald, Amber, and Crimson are strictly reserved for ticket validation and synchronization state.\",\n        \"section\": \"colors\"\n      },\n      {\n        \"name\": \"The No-Hairline-Type Rule\",\n        \"body\": \"Thin or ultra-light weights are prohibited. All interactive labels and status badges must use a minimum weight of 600.\",\n        \"section\": \"typography\"\n      },\n      {\n        \"name\": \"The Downward Gravity Rule\",\n        \"body\": \"Shadows must have a strictly positive Y-offset (height >= 2). Omni-directional glow shadows are banned.\",\n        \"section\": \"elevation\"\n      },\n      {\n        \"name\": \"The Absolute No-Blur Rule\",\n        \"body\": \"Glassmorphism and BlurView components are prohibited. Translucent sheets must use flat alpha scrims.\",\n        \"section\": \"elevation\"\n      }\n    ],\n    \"dos\": [\n      \"Do maintain strict zero-border geometry (borderWidth: 0) across all UI elements.\",\n      \"Do provide immediate haptic and audio feedback on gate scanning operations.\",\n      \"Do ensure all interactive buttons and icons have at least 48x48dp touchable bounding boxes.\",\n      \"Do preserve the anti-screenshot screen capture protection on the ticket detail screen.\",\n      \"Do display dynamic 30-second countdown rings or progress indicators on QR codes.\",\n      \"Do enforce high text contrast (>=4.5:1) for all typography and placeholders.\"\n    ],\n    \"donts\": [\n      \"Don't add outline borders, border-bottom lines, or hairlines anywhere in the application.\",\n      \"Don't use light grey text colors (#94A3B8 or lighter) for any label, placeholder, or indicator.\",\n      \"Don't introduce dark mode or dark themes; the app is exclusively an outdoor glare-resistant Light Theme.\",\n      \"Don't use expo-blur, BlurView, or frosted glass backgrounds.\",\n      \"Don't place critical gate validation controls in the hard-to-reach top quarter of the screen.\",\n      \"Don't allow QR tokens to be cached without cryptographic expiration metadata.\"\n    ]\n  }\n}\n